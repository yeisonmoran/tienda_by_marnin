generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TipoDocumento {
  id_tipo_documento Int    @id @default(autoincrement())
  nombre            String @db.VarChar(80)
  abreviatura       String @db.VarChar(10)

  @@map("tipos_documento")
}

model Rol {
  id_rol    Int    @id @default(autoincrement())
  nombreRol String @map("nombre_rol") @db.VarChar(50)

  @@map("roles")
}

model Usuario {
  id_usuario      Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(100)
  correo          String   @unique(map: "uk_usuarios_correo") @db.VarChar(100)
  contrasena      String   @db.VarChar(255)
  idRol           Int      @map("id_rol")
  idTipoDocumento Int      @map("id_tipo_documento")
  numDocumento    String   @map("numero_documento") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  activo          Boolean  @default(true)

  @@index([idRol], map: "fk_usuarios_rol")
  @@index([idTipoDocumento], map: "fk_usuarios_tdoc")
  @@map("usuarios")
}

model Cliente {
  id_cliente      Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(100)
  correo          String   @db.VarChar(100)
  telefono        String?  @db.VarChar(20)
  numDocumento    String   @map("numero_documento") @db.VarChar(30)
  ciudad          String?  @db.VarChar(80)
  idTipoDocumento Int      @map("id_tipo_documento")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([idTipoDocumento], map: "fk_clientes_tdoc")
  @@map("clientes")
}

model Categoria {
  id_categoria Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(80)
  descripcion  String? @db.VarChar(255)
  activo       Boolean @default(true)

  @@map("categorias")
}

model Producto {
  id_producto Int      @id @default(autoincrement())
  codigo      String   @unique(map: "uk_productos_codigo") @db.VarChar(30)
  nombre      String   @db.VarChar(150)
  marca       String?  @db.VarChar(30)
  precio      Decimal  @default(0.00) @db.Decimal(12, 2)
  stock       Int      @default(0)
  stockMinimo Int      @default(5) @map("stock_minimo")
  idCategoria Int      @map("id_categoria")
  descripcion String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  activo      Boolean  @default(true)

  @@index([idCategoria], map: "fk_productos_cat")
  @@map("productos")
}

model Venta {
  id_venta   Int      @id @default(autoincrement())
  idCliente  Int      @map("id_cliente")
  idUsuario  Int      @map("id_usuario")
  fecha      DateTime @db.Date
  total      Decimal  @default(0.00) @db.Decimal(14, 2)
  estado     String   @default("Completada") @db.VarChar(30)
  metodoPago String   @default("Efectivo") @map("metodo_pago") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([idCliente], map: "fk_ventas_cliente")
  @@index([idUsuario], map: "fk_ventas_usuario")
  @@map("ventas")
}

model DetalleVenta {
  id_detalle     Int     @id @default(autoincrement())
  idVenta        Int     @map("id_venta")
  idProducto     Int     @map("id_producto")
  cantidad       Int     @default(1)
  precioUnitario Decimal @default(0.00) @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @default(0.00) @db.Decimal(14, 2)

  @@index([idProducto], map: "fk_detalle_producto")
  @@index([idVenta], map: "fk_detalle_venta")
  @@map("detalle_ventas")
}
